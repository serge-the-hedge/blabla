{
	"name": "blabla",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.2.2",
			"zod": "^4.1.13",
			"typescript": "^6",
			"next-themes": "^0.4.6",
			"convex": "^1.33.1",
			"better-auth": "1.6.9",
			"@convex-dev/better-auth": "^0.12.1",
			"@types/react-dom": "^19.2.3"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"check-types": "turbo check-types",
		"dev:web": "turbo -F web dev",
		"dev:server": "turbo -F @blabla/backend dev",
		"dev:setup": "turbo -F @blabla/backend dev:setup",
		"check": "biome check --write ."
	},
	"dependencies": {
		"@blabla/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.0",
		"@blabla/config": "workspace:*",
		"@types/node": "^24.3.0",
		"turbo": "^2.8.12",
		"typescript": "catalog:"
	},
	"packageManager": "bun@1.3.13"
}
