  "pom_how_to_edu_btn_finish": "Let's go",
  "@pom_how_to_edu_btn_finish": {},
  "pom_how_to_edu_btn_learn_more": "Learn more",
  "@pom_how_to_edu_btn_learn_more": {},
  "pom_how_to_edu_intro_subtitle": "Unlock the full power of your bricks. Learn how Pockets work",
  "@pom_how_to_edu_intro_subtitle": {},
  "pom_how_to_edu_intro_tag": "Introducing",
  "@pom_how_to_edu_intro_tag": {},
  "pom_how_to_edu_intro_title": "Brickit Pockets",
  "@pom_how_to_edu_intro_title": {},
  "pom_how_to_edu_step_1": "Pockets let you build with as many bricks as you want, whatever you want.",
  "@pom_how_to_edu_step_1": {},
  "pom_how_to_edu_step_2": "Quick Play is fun for building tiny things fast. But what if you want to build big?",
  "@pom_how_to_edu_step_2": {},
  "pom_how_to_edu_step_3": "With Pockets, you can scan every part you have and use them all together!",
  "@pom_how_to_edu_step_3": {},
  "pom_how_to_edu_step_4": "You take a handful of bricks, snap a photo, bag them by number, and move on.",
  "@pom_how_to_edu_step_4": {},
  "pom_how_to_edu_step_5": "Brickit remembers all the info on the parts you have, as well as their pocket number.",
  "@pom_how_to_edu_step_5": {},
  "pom_how_to_edu_step_6": "Easily find any part you want or match building ideas to the exact parts you have!",
