  "pom_about_screen_text_5": "Triez-les dans des sachets numérotés.",
  "@pom_about_screen_text_5": {},
  "pom_about_screen_text_6": "Après cela, tout devient simple :",
  "@pom_about_screen_text_6": {},
  "pom_about_screen_title": "Répertoriez chaque pièce que vous possédez. Construisez en plus grand",
